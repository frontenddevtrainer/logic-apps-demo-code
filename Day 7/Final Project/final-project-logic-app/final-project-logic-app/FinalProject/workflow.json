{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "functionAppUrl": {
        "type": "String",
        "defaultValue": "https://order-processing-func-13332.azurewebsites.net/api/process-order?code=AW_4_OZmvTVxe3PUHT784vEfV_JXkGHRU6if1hRVX4PzAzFukz0dKQ=="
      }
    },
    "triggers": {
      "HTTP_Request_-_Receive_X12_Order": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "x12": {
                "type": "string",
                "description": "Raw X12 850 Purchase Order message"
              },
              "segments": {
                "type": "array",
                "description": "Pre-parsed X12 segments (alternative to x12)"
              },
              "client": {
                "type": "string",
                "description": "Client identifier for mapping selection"
              },
              "transactionSet": {
                "type": "string",
                "description": "Transaction set type (default: 850)"
              },
              "mappingPath": {
                "type": "string",
                "description": "Explicit path to mapping file"
              },
              "mappingBlobUrl": {
                "type": "string",
                "description": "Full SAS URL to mapping file"
              },
              "elementSeparator": {
                "type": "string",
                "description": "Override element separator (default: *)"
              },
              "segmentSeparator": {
                "type": "string",
                "description": "Override segment separator (default: ~)"
              },
              "componentSeparator": {
                "type": "string",
                "description": "Override component separator (default: :)"
              }
            }
          },
          "method": "POST"
        }
      }
    },
    "actions": {
      "Call_Order_Processing_Function": {
        "type": "Http",
        "runAfter": {},
        "inputs": {
          "method": "POST",
          "uri": "@appsetting('functionAppUrl')",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "@addProperty(triggerBody(), 'transactionSet', coalesce(triggerBody()?['transactionSet'], '850'))"
        }
      },
      "Parse_Function_Response": {
        "type": "ParseJson",
        "runAfter": {
          "Call_Order_Processing_Function": [
            "Succeeded"
          ]
        },
        "inputs": {
          "content": "@body('Call_Order_Processing_Function')",
          "schema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "orderId": {
                "type": "string"
              },
              "orderDate": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "summary": {
                "type": "object",
                "properties": {
                  "purchaseOrderNumber": {
                    "type": "string"
                  },
                  "buyer": {
                    "type": "string"
                  },
                  "itemCount": {
                    "type": "integer"
                  },
                  "totalAmount": {
                    "type": "number"
                  }
                }
              },
              "storage": {
                "type": "object",
                "properties": {
                  "database": {
                    "type": "string"
                  },
                  "blobPath": {
                    "type": "string"
                  }
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      },
      "Check_Processing_Result": {
        "type": "If",
        "runAfter": {
          "Parse_Function_Response": [
            "Succeeded"
          ]
        },
        "expression": {
          "and": [
            {
              "equals": [
                "@body('Parse_Function_Response')?['success']",
                true
              ]
            }
          ]
        },
        "actions": {
          "Success_Response": {
            "type": "Response",
            "runAfter": {},
            "inputs": {
              "statusCode": 201,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": "@body('Parse_Function_Response')"
            }
          }
        },
        "else": {
          "actions": {
            "Error_Response": {
              "type": "Response",
              "runAfter": {},
              "inputs": {
                "statusCode": 400,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": "@body('Parse_Function_Response')"
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
