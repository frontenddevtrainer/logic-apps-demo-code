{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "x12-order-processing-workflow",
      "metadata": {
        "description": "Name of the Logic App"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "functionAppUrl": {
      "type": "string",
      "metadata": {
        "description": "URL of the order processing Azure Function (e.g., https://your-function.azurewebsites.net/api/process-order)"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "functionAppUrl": {
              "type": "string",
              "defaultValue": ""
            }
          },
          "triggers": {
            "HTTP_Request_-_Receive_X12_Order": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "x12": {
                      "type": "string",
                      "description": "Raw X12 850 Purchase Order message"
                    },
                    "segments": {
                      "type": "array",
                      "description": "Pre-parsed X12 segments (alternative to x12)"
                    },
                    "client": {
                      "type": "string",
                      "description": "Client identifier for mapping selection"
                    },
                    "transactionSet": {
                      "type": "string",
                      "description": "Transaction set type (default: 850)"
                    },
                    "mappingPath": {
                      "type": "string",
                      "description": "Explicit path to mapping file"
                    },
                    "mappingBlobUrl": {
                      "type": "string",
                      "description": "Full SAS URL to mapping file"
                    },
                    "elementSeparator": {
                      "type": "string",
                      "description": "Override element separator (default: *)"
                    },
                    "segmentSeparator": {
                      "type": "string",
                      "description": "Override segment separator (default: ~)"
                    },
                    "componentSeparator": {
                      "type": "string",
                      "description": "Override component separator (default: :)"
                    }
                  }
                },
                "method": "POST"
              }
            }
          },
          "actions": {
            "Call_Order_Processing_Function": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('functionAppUrl')}",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": "@triggerBody()"
              }
            },
            "Parse_Function_Response": {
              "type": "ParseJson",
              "runAfter": {
                "Call_Order_Processing_Function": ["Succeeded"]
              },
              "inputs": {
                "content": "@body('Call_Order_Processing_Function')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "orderId": { "type": "string" },
                    "orderDate": { "type": "string" },
                    "status": { "type": "string" },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "purchaseOrderNumber": { "type": "string" },
                        "buyer": { "type": "string" },
                        "itemCount": { "type": "integer" },
                        "totalAmount": { "type": "number" }
                      }
                    },
                    "storage": {
                      "type": "object",
                      "properties": {
                        "database": { "type": "string" },
                        "blobPath": { "type": "string" }
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "errors": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "error": { "type": "string" }
                  }
                }
              }
            },
            "Check_Processing_Result": {
              "type": "If",
              "runAfter": {
                "Parse_Function_Response": ["Succeeded"]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@body('Parse_Function_Response')?['success']",
                      true
                    ]
                  }
                ]
              },
              "actions": {
                "Success_Response": {
                  "type": "Response",
                  "runAfter": {},
                  "inputs": {
                    "statusCode": 201,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": "@body('Parse_Function_Response')"
                  }
                }
              },
              "else": {
                "actions": {
                  "Error_Response": {
                    "type": "Response",
                    "runAfter": {},
                    "inputs": {
                      "statusCode": 400,
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": "@body('Parse_Function_Response')"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "functionAppUrl": {
            "value": "[parameters('functionAppUrl')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppEndpoint": {
      "type": "string",
      "value": "[listCallbackURL(concat(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '/triggers/HTTP_Request_-_Receive_X12_Order'), '2019-05-01').value]"
    }
  }
}
